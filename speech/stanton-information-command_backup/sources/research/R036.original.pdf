ï»¿<?xml version = "1.0" encoding = "UTF-8" ?><WatermarkSettings version = "8.0"><SourceFile name="CurrentImage" type=""/><Scale value="0.65"/><Rotation value="0"/><Opacity value="1.0"/><Location ontop="1"/><Color r="0.0" b="0.0" g="0.0"/><Alignment vertalign="0" horizalign="0" vertvalue="-0.02" horizvalue="0.02" unit="10" textalign="0"/><Appearance fixedprint="0" onprint="1" onscreen="1"/><PageRange end="0" start="0" even="1" odd="1"/></WatermarkSettings>
